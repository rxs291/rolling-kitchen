{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rolling-kitchen",
  "main": "src/index.js",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolling-kitchen-orders",
      "database_id": "750b87b2-0577-4bd5-b589-30c1a6dedec1",
    },
  ],
}
